---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({params:{slug:entry.id}, props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <section class="page-hero"><div class="container"><div class="eyebrow">Research project</div><h1>{entry.data.title}</h1><p class="lead">{entry.data.summary}</p><div class="meta-row"><span class="status">{entry.data.status}</span><span>{entry.data.period}</span></div></div></section>
  <div class="container page-content">
    <a class="link-arrow" href={withBase('/projects/')}>← All projects</a>
    <div class="detail-grid" style="margin-top:29px">
      <article class="prose"><Content /></article>
      <aside class="sidebar-panel">
        <h3>Project details</h3>
        <dl>
          <dt>Status</dt><dd>{entry.data.status}</dd>
          <dt>Period</dt><dd>{entry.data.period}</dd>
          <dt>Focus</dt><dd>{entry.data.tags.join(' · ')}</dd>
          {entry.data.paperUrl && <><dt>{entry.data.paperType === 'Preprint' ? 'Preprint' : 'Publication'}</dt><dd><a href={entry.data.paperUrl} target="_blank" rel="noopener noreferrer">View {entry.data.paperType === 'Preprint' ? 'preprint' : 'publication'} ↗</a></dd></>}
          {entry.data.codeUrl && <><dt>Code / resources</dt><dd><a href={entry.data.codeUrl} target="_blank" rel="noopener noreferrer">View repository ↗</a></dd></>}
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>
