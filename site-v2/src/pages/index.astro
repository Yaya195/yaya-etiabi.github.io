---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';
import { withBase, site } from '../lib/site';
import { Image } from 'astro:assets';
import portrait from '../assets/yaya-portrait-cutout.webp';
import { homeStructuredData } from '../lib/seo';

const projects = (await getCollection('projects')).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const featured = projects.filter(p=>p.data.featured).slice(0,3);
const publications = (await getCollection('publications')).filter(p=>p.data.featured).sort((a,b)=>b.data.year-a.data.year).slice(0,3);
const areas = [
  {number:'01',title:'Edge Intelligence & ISCC',description:'Co-design of sensing, communication, and computation for efficient learning and inference at the network edge, including ongoing investigations of neuromorphic approaches.'},
  {number:'02',title:'Wireless Sensing & Localization',description:'Learning from radio measurements and sensor observations for localization and environmental understanding.'},
  {number:'03',title:'Collaborative & Privacy-Preserving ML',description:'Distributed learning, adaptation and communication-efficient knowledge exchange in wireless networks.'},
];
---
<BaseLayout structuredData={homeStructuredData()}>
  <section class="hero personal-hero">
    <div class="container hero-grid personal-hero-grid">
      <div class="hero-copy">
        <h1>Yaya Etiabi <span class="hero-degree">PhD</span></h1>
        <p class="hero-role">{site.strapline}</p>
        <p class="hero-specialties">{site.focus}</p>
        <p class="lead">My research focuses on machine learning for wireless systems, at the intersection of Edge Intelligence and integrated sensing, communication, and computation (ISCC). I investigate how learning and inference can be made efficient at the network edge under resource constraints.</p>
        <p class="muted">My background includes collaborative and privacy-preserving machine learning, wireless localization, and radio sensing, providing a foundation for my research on intelligent and resource-efficient wireless systems.</p>
        <div class="hero-links" aria-label="Explore this research website">
          <a href={withBase('/research/')}>Research <span aria-hidden="true">↗</span></a>
          <a href={withBase('/publications/')}>Publications <span aria-hidden="true">↗</span></a>
          <a href={withBase('/about/')}>About <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-profiles">
          <a href={site.scholar}>Google Scholar</a>
          <span aria-hidden="true">·</span>
          <a href={site.github}>GitHub</a>
          <span aria-hidden="true">·</span>
          <a href={site.linkedin}>LinkedIn</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <Image src={portrait} alt="Portrait of Yaya Etiabi" width={480} format="webp" quality={80} loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Research directions</div><h2>Questions that connect my work</h2><p>My current research explores the integration of intelligence, sensing, communication, and computation in wireless systems, building on earlier work in collaborative learning, wireless sensing, and localization.</p></div><a class="link-arrow" href={withBase('/research/')}>Research overview ↗</a></div>
      <div class="grid-3">{areas.map(area=><article class="card"><div class="kicker">{area.number} / Research area</div><h3>{area.title}</h3><p>{area.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Selected work</div><h2>Research projects</h2></div><a class="link-arrow" href={withBase('/projects/')}>All projects ↗</a></div>
      <div class="grid-3">{featured.map((project,index)=><ProjectCard slug={project.id} title={project.data.title} summary={project.data.summary} status={project.data.status} period={project.data.period} tags={project.data.tags} index={index}/>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow section-label">Research outputs</div><h2>Publications</h2><p>Peer-reviewed work in machine learning, distributed systems and wireless localization.</p></div><a class="link-arrow" href={withBase('/publications/')}>Full publication list ↗</a></div>
      <ul class="pub-list">{publications.map(p=><PublicationItem {...p.data}/>)}</ul>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow section-label">Academic &amp; community activities</div>
          <h2>Teaching, Mentoring &amp; Outreach</h2>
        </div>
        <a class="link-arrow" href={withBase('/teaching-outreach/')}>Explore these activities ↗</a>
      </div>
      <div class="grid-3 activity-grid">
        <article class="card activity-card">
          <svg class="activity-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 7c-2-1.6-5-2.2-9-1.5v13c4-.7 7-.1 9 1.5 2-1.6 5-2.2 9-1.5v-13c-4-.7-7-.1-9 1.5Z" /><path d="M12 7v13" />
          </svg>
          <h3>Teaching</h3>
          <p>Programming, Python and machine learning courses and practical sessions.</p>
        </article>
        <article class="card activity-card">
          <svg class="activity-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m2 9 10-5 10 5-10 5L2 9Z" /><path d="M6 11v5c3 2.5 9 2.5 12 0v-5" /><path d="M22 9v7" />
          </svg>
          <h3>Mentoring</h3>
          <p>Research project supervision, from problem formulation to experimental evaluation.</p>
        </article>
        <article class="card activity-card">
          <svg class="activity-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="8" r="3" /><path d="M2.5 20v-2a6.5 6.5 0 0 1 13 0v2M17 5.5a3 3 0 0 1 0 5.5M18 14a5.3 5.3 0 0 1 3.5 5v1" />
          </svg>
          <h3>Outreach</h3>
          <p>AI literacy, knowledge sharing and community learning initiatives.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
